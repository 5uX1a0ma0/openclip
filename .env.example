# OpenList Clipboard application
CLIPBOARD_ADDR=:8080
CLIPBOARD_ALLOWED_ORIGIN=
CLIPBOARD_CREATE_PASSWORD=change-this-create-password
CLIPBOARD_MAX_BLOB_BYTES=52428800
CLIPBOARD_TRUST_PROXY_HEADERS=false

# Only needed when running `go run ./cmd/server` with a non-default frontend path.
# Docker images set this to /app/frontend/dist internally.
# CLIPBOARD_STATIC_DIR=frontend/dist

# Optional Web Push notifications. Leave all three empty to disable Web Push.
CLIPBOARD_VAPID_PUBLIC_KEY=
CLIPBOARD_VAPID_PRIVATE_KEY=
CLIPBOARD_VAPID_SUBJECT=

# Existing OpenList instance
OPENLIST_BASE_URL=http://127.0.0.1:5244
OPENLIST_USERNAME=clipboard
OPENLIST_PASSWORD=change-this-openlist-password
OPENLIST_OTP_CODE=
# OpenList virtual path under an existing mounted storage, not a host filesystem path.
OPENLIST_ROOT=/clipboard
OPENLIST_CLIENT_ID=openlist-clipboard-gateway
